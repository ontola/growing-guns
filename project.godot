[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="projectile"

[physics]

common/max_physics_steps_per_frame=6
common/physics_jitter_fix=0.0
common/physics_interpolation=true

[raytraced_audio]

reverb_bus=&"RaytracedReverb"
ambient_bus=&"RaytracedAmbient"

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.02, 0.08, 1)
shader_compilation/pso_cache_size_mb=64

[shader_globals]

world_light_dim={
"type": "float",
"value": 1.0
}
