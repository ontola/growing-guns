; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Growing Guns"
config/description="High-paced multiplayer arena shooter"
config/version="0.3.3"
run/main_scene="res://scenes/start_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=360
config/icon="res://icon.svg"

[audio]

general/3d_panning_strength=1.0

[autoload]

NetworkManager="*res://scripts/network_manager.gd"
SFX="*res://scripts/sfx.gd"
CrowdAudio="*res://scripts/crowd_audio.gd"
ProceduralMusic="*res://scripts/procedural_music.gd"
PerfGovernor="*res://scripts/perf_governor.gd"
Trace="*res://scripts/trace.gd"
GameNight="*res://addons/gamenight/gamenight.gd"
GameNightScreen="*res://addons/gamenight/screen.gd"
GameNightBridge="*res://scripts/gamenight_bridge.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1281
window/size/viewport_height=720
window/size/mode=1
window/size/no_focus=true
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/raytraced_audio/plugin.cfg", "res://addons/gamenight/plugin.cfg")

[input]

ui_cancel={
"deadzone": 0.5,
